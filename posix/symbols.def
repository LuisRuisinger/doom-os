                  int protection, int flags, int fd, off_t offset)
POSIX_STUB(int, munmap, -1, ENOSYS, void *address, size_t length)
POSIX_STUB(int, mprotect, -1, ENOSYS, void *address, size_t length, int protection)
POSIX_STUB(void *, mremap, reinterpret_cast<void *>(-1), ENOMEM, void *old_address,
                  size_t old_size, size_t new_size, int flags, ...)

