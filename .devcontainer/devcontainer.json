{
  "name": "DoomOS",

  // repo root image; also published by CI
  "build": {
    "context": "..",
    "dockerfile": "../Dockerfile"
  },
  "workspaceFolder": "/workspace/DoomOS",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace/DoomOS,type=bind",
  "remoteUser": "ubuntu",
  "runArgs": [
    "--init",

    // things gdb needs to attach to
    "--cap-add=SYS_PTRACE",
    "--security-opt=seccomp=unconfined",

    // display forwarding for container
    "--env=DISPLAY=${localEnv:DISPLAY}",
    "--volume=/tmp/.X11-unix:/tmp/.X11-unix:rw"
  ],

  "mounts": [
    "source=${localEnv:HOME}/.bashrc,target=/home/ubuntu/.bashrc,type=bind,readonly"
  ],
  // The libc line is not decoration. The kernel builds without one, so a toolchain missing newlib
  // fails nowhere until an application is configured - and an attached container built from a
  // stale image looks identical to a current one until something asks it for libc.a. Printing the
  // path at creation is what makes "which image am I on" answerable at a glance.
  "postCreateCommand": "x86_64-elf-gcc --version && x86_64-elf-g++ --version && cmake --version && ninja --version && clang-format --version && grub-mkrescue --version && qemu-system-x86_64 --version && echo \"libc: $(x86_64-elf-gcc -print-file-name=libc.a)\""
}
