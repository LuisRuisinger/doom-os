// =================================================================================================
// Known POSIX / Linux ABI symbols
//
// This file is intentionally not guarded. It is an X-macro list included by code that wants to
// generate declarations, weak fallbacks, diagnostics, or build checks from the same ABI surface.
//
// Macro contract:
//   POSIX_STUB(return_type, name, return_value, errno_value, parameters...)
//
// errno_value == 0 means the fallback returns a stable value without touching errno.
// =================================================================================================

// -------------------------------------------------------------------------------------------------
// Process, users, sessions, and scheduling
// -------------------------------------------------------------------------------------------------

POSIX_STUB(pid_t, fork, -1, ENOSYS, void)
POSIX_STUB(int, execvp, -1, ENOSYS, const char *file, char *const argv[])
POSIX_STUB(pid_t, waitpid, -1, ENOSYS, pid_t pid, int *status, int options)
POSIX_STUB(int, waitid, -1, ENOSYS, idtype_t idtype, id_t id, siginfo_t *info, int options)
POSIX_STUB(int, pause, -1, ENOSYS, void)
POSIX_STUB(pid_t, getppid, -1, ENOSYS, void)
POSIX_STUB(uid_t, getuid, static_cast<uid_t>(-1), ENOSYS, void)
POSIX_STUB(int, setuid, -1, ENOSYS, uid_t uid)
POSIX_STUB(int, setgid, -1, ENOSYS, gid_t gid)
POSIX_STUB(int, setgroups, -1, ENOSYS, size_t count, const gid_t *groups)
POSIX_STUB(int, setpgid, -1, ENOSYS, pid_t pid, pid_t pgid)
POSIX_STUB(pid_t, setsid, -1, ENOSYS, void)
POSIX_STUB(int, sched_yield, -1, ENOSYS, void)
POSIX_STUB(int, sched_getaffinity, -1, ENOSYS, pid_t pid, size_t cpusetsize, void *mask)
POSIX_STUB(int, poll, -1, ENOSYS, pollfd *fds, nfds_t count, int timeout)

POSIX_STUB(int, isatty, 0, 0, int fd)
POSIX_STUB(pid_t, getpid, 1, 0, void)
POSIX_STUB(int, kill, -1, EINVAL, pid_t pid, int signal)

// -------------------------------------------------------------------------------------------------
// Threads and synchronization
// -------------------------------------------------------------------------------------------------

POSIX_STUB(int, pthread_attr_destroy, 0, 0, pthread_attr_t *attr)
POSIX_STUB(int, pthread_attr_getguardsize, 0, 0, const pthread_attr_t *attr, size_t *guardsize)
POSIX_STUB(int, pthread_attr_getstack, 0, 0, const pthread_attr_t *attr, void **stackaddr,
            size_t *stacksize)
POSIX_STUB(int, pthread_attr_init, 0, 0, pthread_attr_t *attr)
POSIX_STUB(int, pthread_attr_setstacksize, 0, 0, pthread_attr_t *attr, size_t stacksize)
POSIX_STUB(int, pthread_create, -1, ENOSYS, pthread_t *thread, const pthread_attr_t *attr,
                  void *(*start)(void *), void *arg)
POSIX_STUB(int, pthread_detach, -1, ENOSYS, pthread_t thread)
POSIX_STUB(int, pthread_getattr_np, -1, ENOSYS, pthread_t thread, pthread_attr_t *attr)
POSIX_STUB(int, pthread_join, -1, ENOSYS, pthread_t thread, void **result)
POSIX_STUB(int, pthread_key_create, -1, ENOSYS, pthread_key_t *key,
                  void (*destructor)(void *))
POSIX_STUB(int, pthread_key_delete, -1, ENOSYS, pthread_key_t key)
POSIX_STUB(pthread_t, pthread_self, static_cast<pthread_t>(-1), ENOSYS, void)
POSIX_STUB(int, pthread_setname_np, -1, ENOSYS, pthread_t thread, const char *name)
POSIX_STUB(int, pthread_setspecific, -1, ENOSYS, pthread_key_t key, const void *value)

