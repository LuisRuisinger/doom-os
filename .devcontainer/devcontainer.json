{
  "name": "DoomOS",
  "build": {
    "context": "..",
    "dockerfile": "../Dockerfile",
    "args": {
      "TARGET": "x86_64-elf",
      "PREFIX": "/opt/cross",
      "BINUTILS_VERSION": "2.46.1",
      "GCC_VERSION": "15.3.0"
    }
  },
  "workspaceFolder": "/workspace/DoomOS",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace/DoomOS,type=bind",
  "remoteUser": "root",
  "runArgs": [
    "--init",
    "--cap-add=SYS_PTRACE",
    "--security-opt=seccomp=unconfined",
    "--env=DISPLAY=${localEnv:DISPLAY}",
    "--volume=/tmp/.X11-unix:/tmp/.X11-unix:rw"
  ],
  "mounts": [
    "source=${localEnv:HOME}/.bashrc,target=/root/.bashrc,type=bind,readonly"
  ],
  "postCreateCommand": "x86_64-elf-gcc --version && x86_64-elf-g++ --version && grub-mkrescue --version && qemu-system-x86_64 --version"
}