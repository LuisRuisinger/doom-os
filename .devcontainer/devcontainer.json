{
  "name": "DoomOS",
  "build": {
    "context": "..",
    "dockerfile": "../Dockerfile"
  },
  "workspaceFolder": "/workspace/DoomOS",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace/DoomOS,type=bind",
  "remoteUser": "ubuntu",
  "runArgs": [
    "--init",

    // gdb
    "--cap-add=SYS_PTRACE",
    "--security-opt=seccomp=unconfined",

    // qemu window
    "--env=DISPLAY=${localEnv:DISPLAY}",
    "--volume=/tmp/.X11-unix:/tmp/.X11-unix:rw"
  ],

  // A bind mount with a missing source fails, so the neovim directories are created on the
  // host first; without a config there they stay empty and neovim starts bare.
  "initializeCommand": "mkdir -p ~/.config/nvim ~/.local/share/nvim ~/.local/state/nvim ~/.cache/nvim",
  "mounts": [
    "source=${localEnv:HOME}/.bashrc,target=/home/ubuntu/.bashrc,type=bind,readonly",

    // neovim config, plugins, mason packages and parsers come from the host; nothing is fetched
    // in the container and installs made here land on the host
    "source=${localEnv:HOME}/.config/nvim,target=/home/ubuntu/.config/nvim,type=bind",
    "source=${localEnv:HOME}/.local/share/nvim,target=/home/ubuntu/.local/share/nvim,type=bind",
    "source=${localEnv:HOME}/.local/state/nvim,target=/home/ubuntu/.local/state/nvim,type=bind",
    "source=${localEnv:HOME}/.cache/nvim,target=/home/ubuntu/.cache/nvim,type=bind"
  ]
}
